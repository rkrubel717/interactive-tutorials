        // কুইজ লোড
        function loadRandomQuiz() {
            const questions = [
                {
                    question: "ইসলামে মায়ের হক বাবার চেয়ে কত গুণ বেশি?",
                    options: ["১ গুণ", "২ গুণ", "৩ গুণ", "৪ গুণ"],
                    answer: 2
                },
                {
                    question: "সৎ কাঠুরের গল্পে দেবতা তাকে কয়টি কুড়াল দিয়েছিলেন?",
                    options: ["১টি", "২টি", "৩টি", "৪টি"],
                    answer: 2
                },
                {
                    question: "ধৈর্যের গল্পে ছোট ভাই কোথায় গুহা পেয়েছিল?",
                    options: ["মাঝ পাহাড়ে", "পাহাড়ের চূড়ায়", "পাহাড়ের নিচে", "জঙ্গলে"],
                    answer: 1
                }
            ];
            
            const randomQuestion = questions[Math.floor(Math.random() * questions.length)];
            
            document.getElementById('quiz-question').textContent = randomQuestion.question;
            
            const quizOptions = document.getElementById('quiz-options');
            quizOptions.innerHTML = '';
            
            randomQuestion.options.forEach((option, index) => {
                const optionDiv = document.createElement('div');
                optionDiv.className = 'quiz-option';
                optionDiv.textContent = option;
                optionDiv.dataset.index = index;
                
                optionDiv.addEventListener('click', function() {
                    document.querySelectorAll('.quiz-option').forEach(opt => {
                        opt.classList.remove('selected');
                    });
                    this.classList.add('selected');
                    document.getElementById('submit-quiz').style.display = 'block';
                });
                
                quizOptions.appendChild(optionDiv);
            });
            
            document.getElementById('submit-quiz').onclick = function() {
                const selectedOption = document.querySelector('.quiz-option.selected');
                if (!selectedOption) {
                    showToast("অনুগ্রহ করে একটি উত্তর নির্বাচন করুন");
                    return;
                }
                
                const selectedIndex = parseInt(selectedOption.dataset.index);
                const resultDiv = document.getElementById('quiz-result');
                
                if (selectedIndex === randomQuestion.answer) {
                    resultDiv.innerHTML = `<div style="color: green; font-weight: bold;">সঠিক উত্তর! খুব ভালো!</div>`;
                } else {
                    resultDiv.innerHTML = `<div style="color: red; font-weight: bold;">ভুল উত্তর। সঠিক উত্তর: ${randomQuestion.options[randomQuestion.answer]}</div>`;
                }
                
                resultDiv.style.display = 'block';
                document.getElementById('submit-quiz').style.display = 'none';
            };
        }
        
