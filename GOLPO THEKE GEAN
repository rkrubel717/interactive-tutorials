        // ফিল্টার ইভেন্ট যোগ
        function addFilterEvents() {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    document.querySelectorAll('.filter-btn').forEach(b => {
                        b.classList.remove('active');
                    });
                    this.classList.add('active');
                    
                    // ফিল্টার লজিক (সিম্পল ভার্সন)
                    const filter = this.dataset.filter;
                    const storyCards = document.querySelectorAll('.story-card');
                    
                    storyCards.forEach(card => {
                        card.style.display = 'block';
                        
                        if (filter === 'short') {
                            // সংক্ষিপ্ত গল্প (500 অক্ষরের কম)
                            const storyText = card.querySelector('.story-text').textContent;
                            if (storyText.length > 500) {
                                card.style.display = 'none';
                            }
                        } else if (filter === 'long') {
                            // দীর্ঘ গল্প (500 অক্ষরের বেশি)
                            const storyText = card.querySelector('.story-text').textContent;
                            if (storyText.length <= 500) {
                                card.style.display = 'none';
                            }
                        }
                        // অন্যান্য ফিল্টার লজিক এখানে যোগ করা যাবে
                    });
                });
            });
        }
        
        // স্টোরি অ্যাকশন ইভেন্ট যোগ
        function addStoryActionsEvents() {
            document.querySelectorAll('.story-btn').forEach(btn => {
                btn.addEventListener('click', function() {
                    const storyCard = this.closest('.story-card');
                    const category = storyCard.dataset.category;
                    const index = parseInt(storyCard.dataset.index);
                    const action = this.dataset.action;
                    
                    const storyId = `${category}-${index}`;
                    
                    if (action === 'like') {
                        // লাইক টগল
                        const likeSpan = this.querySelector('span');
                        let likes = parseInt(likeSpan.textContent);
                        
                        if (userData.likedStories.includes(storyId)) {
                            // আনলাইক
                            likes--;
                            userData.likedStories = userData.likedStories.filter(id => id !== storyId);
                            this.classList.remove('liked');
                        } else {
                            // লাইক
                            likes++;
                            userData.likedStories.push(storyId);
                            this.classList.add('liked');
                        }
                        
                        likeSpan.textContent = likes;
                        showToast(this.classList.contains('liked') ? "গল্পটি পছন্দ করেছেন" : "লাইক সরানো হয়েছে");
                    } 
                    else if (action === 'save') {
                        // সেভ টগল
                        if (userData.savedStories.includes(storyId)) {
                            // আনসেভ
                            userData.savedStories = userData.savedStories.filter(id => id !== storyId);
                            this.classList.remove('saved');
                            this.innerHTML = '<i class="fas fa-bookmark"></i> সংরক্ষণ';
                            showToast("সংরক্ষণ সরানো হয়েছে");
                        } else {
                            // সেভ
                            userData.savedStories.push(storyId);
                            this.classList.add('saved');
                            this.innerHTML = '<i class="fas fa-bookmark"></i> সংরক্ষিত';
                            showToast("গল্পটি সংরক্ষণ করা হয়েছে");
                        }
                    }
                    else if (action === 'share') {
                        // শেয়ার
                        const story = storiesData[category].stories[index];
                        const text = `"${story.title}" - ${story.moral.substring(0, 100)}...`;
                        const url = window.location.href;
                        
                        if (navigator.share) {
                            navigator.share({
                                title: story.title,
                                text: text,
                                url: url
                            });
                        } else {
                            // ফоллбэк
                            navigator.clipboard.writeText(`${story.title}\n\n${text}\n\n${url}`).then(() => {
                                showToast("গল্পের লিঙ্ক কপি করা হয়েছে");
                            });
                        }
                    }
                    
                    // রিড হিস্ট্রি যোগ
                    if (!userData.readStories.includes(storyId)) {
                        userData.readStories.push(storyId);
                    }
                    
                    // ডাটা সেভ
                    saveUserData();
                    
                    // প্রগ্রেস বার আপডেট
                    updateProgressBars();
                    
                    // অডিও প্লেয়ার শো
                    if (action !== 'share') {
                        showAudioPlayer(category, index);
                    }
                });
            });
        }
        
        // অডিও প্লেয়ার শো
        function showAudioPlayer(category, index) {
            const story = storiesData[category].stories[index];
            const audioPlayer = document.getElementById('audio-player');
            const audioElement = document.getElementById('story-audio');
            
            audioPlayer.style.display = 'block';
            document.getElementById('audio-title').textContent = `শুনুন: ${story.title}`;
            
            // অডিও সোর্স সেট করুন
            if (story.audio) {
                audioElement.src = story.audio;
            } else {
                // র‍্যান্ডম অডিও স্যাম্পল
                const randomAudio = audioSamples[Math.floor(Math.random() * audioSamples.length)];
                audioElement.src = randomAudio;
            }
            
            // অডিও লোড
            audioElement.load();
            
            // ডাউনলোড বাটন ইভেন্ট
            document.getElementById('download-audio-btn').onclick = function() {
                showModal("অডিও ডাউনলোড", "শীঘ্রই এই গল্পের অডিও ভার্সন ডাউনলোড করার সুবিধা যুক্ত করা হবে।");
